---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" noIndex>
  <section class="four-oh-four">
    <div class="container narrow">
      <p class="eyebrow">404</p>
      <h1>This page isn’t here.</h1>
      <p class="lede">
        Either it never was, or it moved, or I unmade it. The site is
        hand-tended; sometimes things shift.
      </p>
      <p><a href="/">← Back to the front door</a></p>
    </div>
  </section>
</Base>

<style>
  .narrow { max-width: 700px; }
  .four-oh-four { padding-block: var(--space-3xl) var(--space-3xl); }
  .four-oh-four .eyebrow { margin-bottom: var(--space-m); }
  .four-oh-four h1 { font-size: var(--step-5); font-weight: 300; margin-bottom: var(--space-m); }
  .lede {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-2);
    font-weight: 300;
    color: var(--ink-soft);
    margin-bottom: var(--space-l);
    max-width: 40ch;
  }
</style>
