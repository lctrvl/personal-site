---
import Base from '../../layouts/Base.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const meals = await getCollection('meals');
  return meals.map((meal) => ({
    params: { slug: meal.id },
    props: { meal },
  }));
}

interface Props { meal: CollectionEntry<'meals'>; }
const { meal } = Astro.props;
const { Content } = await render(meal);
const { title, date, cover, coverAlt, commentary } = meal.data;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<Base title={title} description={`A meal entry: ${title}.`}>
  <article class="meal">
    <header class="meal-head">
      <div class="container">
        <p class="eyebrow">
          <span>From the kitchen</span>
          <span aria-hidden="true">·</span>
          <span>{fmt(date)}</span>
        </p>
        <h1>{title}</h1>
      </div>
    </header>

    <div class="container">
      <div class="meal-layout">
        <div class="meal-text">
          <div class="prose meal-body">
            <Content />
          </div>

          {commentary && (
            <aside class="commentary">
              <h2>What's behind</h2>
              <p>{commentary}</p>
            </aside>
          )}
        </div>

        {cover && (
          <figure class="cover">
            <img src={cover} alt={coverAlt || ''} loading="eager" />
          </figure>
        )}
      </div>
    </div>

    <nav class="meal-foot">
      <div class="container">
        <a href="/table" class="back">← All meals</a>
      </div>
    </nav>
  </article>
</Base>

<style>
  .meal-head {
    padding-block: var(--space-2xl) 0;
  }
  .meal-head .eyebrow {
    margin-bottom: var(--space-m);
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.5em;
  }
  .meal-head h1 {
    font-size: var(--step-3);
    font-weight: 300;
    line-height: 1;
    margin-bottom: 0;
  }

  .meal-layout {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: var(--space-2xl);
    align-items: start;
    padding-block: var(--space-m) var(--space-xl);
  }

  .meal-text {
    max-width: 56ch;
  }

  .meal-body {
  margin-bottom: var(--space-l);
}
.meal-body :global(p) {
  font-size: var(--step-0);
  line-height: 1.6;
  margin-bottom: 1em;
  color: var(--ink);
}
.meal-body :global(p:last-child) {
  margin-bottom: 0;
}

  .commentary {
    margin-top: var(--space-l);
    padding-top: var(--space-l);
    border-top: 1px solid var(--rule);
  }
  .commentary h2 {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-style: italic;
    font-variation-settings: 'opsz' 80;
    color: var(--ink-soft);
    margin-bottom: 0.5em;
  }
  .commentary p {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 300;
    font-variation-settings: 'opsz' 100;
    color: var(--ink);
    line-height: 1.5;
    margin: 0;
  }

  .cover {
    margin: 0;
  }
  .cover img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    display: block;
  }

  .meal-foot { padding-block: var(--space-l) var(--space-xl); }
  .back {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-soft);
  }

  @media (max-width: 660px) {
    .meal-layout {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }
    .cover {
      max-width: 480px;
      order: -1;
    }
  }
</style>