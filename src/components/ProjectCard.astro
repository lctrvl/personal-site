---
import { domains } from '../config';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index?: number;
}
const { project, index = 0 } = Astro.props;
const { title, summary, domain, kind, date, dateEnd, status, tags, pullquote } = project.data;
const domainLabel = domains[domain].label;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
const dateLabel = dateEnd ? `${fmt(date)} – ${fmt(dateEnd)}` : fmt(date);
---
<article class="project-card" style={`--i: ${index}`}>
  <a href={`/made/${project.id}`} class="project-link">
    <div class="card-head">
      <div class="meta">
        <span class="domain">{domainLabel}</span>
        <span class="dot" aria-hidden="true">·</span>
        <span class="kind">{kind}</span>
      </div>
      <span class="date">{dateLabel}</span>
    </div>

    <h3 class="title">{title}</h3>
    <p class="summary">{summary}</p>

    {pullquote && (
      <p class="pull">“{pullquote}”</p>
    )}

    {tags.length > 0 && (
      <ul class="tags">
        {tags.slice(0, 5).map((tag) => <li>{tag}</li>)}
      </ul>
    )}

    <span class="read-more">
      Read the case <span aria-hidden="true">→</span>
    </span>
  </a>
  {status === 'active' || status === 'ongoing' ? (
    <span class="status-pip" aria-label={`Status: ${status}`}>{status}</span>
  ) : null}
</article>

<style>
  .project-card {
    position: relative;
    border-top: 1px solid var(--rule-strong);
    padding-block: var(--space-l);
    transition: background 300ms ease;
  }
  .project-card:hover {
    background: linear-gradient(
      to right,
      transparent,
      rgba(176, 132, 56, 0.05) 50%,
      transparent
    );
  }

  .project-card:last-child {
    border-bottom: 1px solid var(--rule-strong);
  }

  .project-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .project-link:hover { text-decoration: none; }

  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-m);
    margin-bottom: var(--space-s);
  }

  .meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-muted);
    display: flex;
    align-items: baseline;
    gap: 0.5em;
    flex-wrap: wrap;
  }
  .domain { color: var(--oxblood); }
  .dot { color: var(--rule-strong); }

  .date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .title {
    font-size: var(--step-3);
    font-weight: 400;
    margin-bottom: 0.4em;
    color: var(--ink);
    transition: color 200ms ease;
  }
  .project-link:hover .title { color: var(--oxblood); }

  .summary {
    max-width: 65ch;
    color: var(--ink-soft);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .pull {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-1);
    color: var(--ink);
    font-variation-settings: 'opsz' 80;
    font-weight: 300;
    margin-top: 1em;
    padding-left: 1em;
    border-left: 2px solid var(--brass);
    max-width: 50ch;
  }

  .tags {
    list-style: none;
    padding: 0;
    margin-top: var(--space-m);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .tags li {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.3em 0.7em;
    border: 1px solid var(--rule);
    border-radius: 2px;
    color: var(--ink-muted);
  }

  .read-more {
    display: inline-block;
    margin-top: var(--space-m);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--oxblood);
  }
  .read-more span { transition: transform 200ms ease; display: inline-block; }
  .project-link:hover .read-more span { transform: translateX(4px); }

  .status-pip {
    position: absolute;
    top: var(--space-l);
    right: 0;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--brass);
    padding: 0.2em 0.5em;
    background: rgba(176, 132, 56, 0.1);
    border-radius: 2px;
  }
</style>
